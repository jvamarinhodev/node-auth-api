<html lang='pt-br'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Usuários</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <link rel='stylesheet' href='/css/profile.css' />
  </head>
  <body>
    <div class='stars'></div>

    <div class='layout'>
      <aside class='sidebar'>
        <div class='brand'>
          <div class='brand-mark'></div>
          <div class='brand-name'>Painel</div>
        </div>

        <nav class='primary-nav'>
          <div class='nav-label'>Navegação</div>
          <a href='/private/profile' class='nav-item active'><span class='nav-dot'></span>Usuários Privados</a>
          <a href='/home/profile' class='nav-item'><span class='nav-dot'></span>Usuários Públicos</a>
        </nav>

        <div class='sidebar-footer'>
          <div class='status-line'><span class='pulse-dot'></span>Sistema operacional</div>
          Sessão autenticada
        </div>
      </aside>

      <main>
        <div class='topbar'>
          <div>
            <div class='eyebrow'>Área restrita</div>
            <h1>Todos os usuários</h1>
          </div>
        </div>

        <section class='panel'>
          <div class='panel-header'>
            <div class='panel-title'>Usuários cadastrados</div>
            <div class='panel-sub'>{{users.length}} registros</div>
          </div>

          {{#if users.length}}
            <table>
              <thead>
                <tr>
                  <th>Usuário</th>
                  <th>E-mail</th>
                </tr>
              </thead>
              <tbody>
                {{#each users}}
                  <tr>
                    <td>
                      <div class='row-user'>
                        <div class='avatar'></div>
                        {{this.name}}
                      </div>
                    </td>
                    <td>{{this.email}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          {{else}}
            <div class='empty-state'>Nenhum usuário encontrado.</div>
          {{/if}}
        </section>
      </main>
    </div>
  </body>
</html>
