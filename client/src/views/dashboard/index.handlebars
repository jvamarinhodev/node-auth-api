<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Usuários</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style>
    :root {
      --bg-deep: #0a0e1a;
      --panel: #121729;
      --panel-border: #232b45;
      --panel-raised: #161d33;
      --text-main: #e8ecf4;
      --text-muted: #7a85a3;
      --text-dim: #4a5170;
      --accent-a: #4fd1c5;
      --accent-b: #9f7aea;
      --danger: #f0708a;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--bg-deep);
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-main);
      min-height: 100%;
    }
    body { position: relative; overflow-x: hidden; }
    .stars {
      content: '';
      position: fixed; inset: 0;
      background-image:
        radial-gradient(1.5px 1.5px at 20px 30px, #ffffff40, transparent),
        radial-gradient(1.5px 1.5px at 140px 90px, #ffffff30, transparent),
        radial-gradient(1px 1px at 90px 160px, #ffffff28, transparent),
        radial-gradient(2px 2px at 220px 60px, #ffffff35, transparent),
        radial-gradient(1px 1px at 260px 200px, #ffffff22, transparent),
        radial-gradient(1.5px 1.5px at 320px 140px, #ffffff30, transparent),
        radial-gradient(1px 1px at 40px 220px, #ffffff22, transparent),
        radial-gradient(2px 2px at 380px 30px, #ffffff30, transparent);
      background-repeat: repeat;
      background-size: 400px 260px;
      z-index: 0; pointer-events: none;
      animation: drift 220s linear infinite;
      opacity: 0.6;
    }
    @keyframes drift { from { transform: translateY(0); } to { transform: translateY(-1000px); } }

    .layout {
      position: relative; z-index: 1;
      display: grid;
      grid-template-columns: 240px 1fr;
      min-height: 100vh;
    }

    .sidebar {
      background: var(--panel);
      border-right: 1px solid var(--panel-border);
      padding: 28px 20px;
      display: flex; flex-direction: column; gap: 36px;
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-mark {
      width: 26px; height: 26px; border-radius: 7px;
      background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
      flex-shrink: 0;
    }
    .brand-name { font-family: 'Fraunces', serif; font-weight: 600; font-size: 16px; }

    nav.primary-nav { display: flex; flex-direction: column; gap: 2px; }
    .nav-label {
      font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-dim); margin: 0 0 10px 10px;
    }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 10px; border-radius: 8px; font-size: 13px;
      color: var(--text-muted); text-decoration: none; border: 1px solid transparent;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .nav-item:hover { color: var(--text-main); background: var(--panel-raised); }
    .nav-item.active {
      color: var(--text-main); background: var(--panel-raised);
      border-color: var(--panel-border); position: relative;
    }
    .nav-item.active::before {
      content: ''; position: absolute; left: -10px; top: 50%;
      transform: translateY(-50%); width: 3px; height: 16px; border-radius: 3px;
      background: linear-gradient(180deg, var(--accent-a), var(--accent-b));
    }
    .nav-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-dim); flex-shrink: 0; }
    .nav-item.active .nav-dot, .nav-item:hover .nav-dot { background: var(--accent-a); }

    .sidebar-footer {
      margin-top: auto; font-size: 11px; color: var(--text-dim);
      border-top: 1px solid var(--panel-border); padding-top: 16px; letter-spacing: 0.04em;
    }
    .status-line { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .pulse-dot {
      width: 7px; height: 7px; border-radius: 50%; background: var(--accent-a);
      animation: pulse 2.2s ease-out infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(79, 209, 197, 0.5); }
      70% { box-shadow: 0 0 0 8px rgba(79, 209, 197, 0); }
      100% { box-shadow: 0 0 0 0 rgba(79, 209, 197, 0); }
    }

    main { padding: 32px 40px 60px; max-width: 1180px; }
    .topbar {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 32px; flex-wrap: wrap; gap: 16px;
    }
    .eyebrow {
      font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 8px;
    }
    h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 30px; margin: 0; letter-spacing: -0.01em; }

    .panel {
      background: var(--panel); border: 1px solid var(--panel-border);
      border-radius: 14px; padding: 24px; position: relative;
    }
    .panel::before {
      content: ''; position: absolute; inset: -1px; border-radius: 14px; padding: 1px;
      background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      opacity: 0.18; animation: breathe 5s ease-in-out infinite; pointer-events: none;
    }
    @keyframes breathe { 0%, 100% { opacity: 0.1; } 50% { opacity: 0.3; } }

    .panel-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .panel-title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 16px; }
    .panel-sub { font-size: 11px; color: var(--text-dim); letter-spacing: 0.06em; }

    table { width: 100%; border-collapse: collapse; font-size: 12.5px; margin-top: 4px; }
    th {
      text-align: left; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-dim); font-weight: 500; padding: 0 0 10px; border-bottom: 1px solid var(--panel-border);
    }
    td { padding: 11px 0; border-bottom: 1px solid var(--panel-border); color: var(--text-main); }
    tr:last-child td { border-bottom: none; }
    .row-user { display: flex; align-items: center; gap: 10px; }
    .avatar {
      width: 22px; height: 22px; border-radius: 6px;
      background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
      opacity: 0.75;
    }
    .empty-state { color: var(--text-dim); font-size: 12.5px; padding: 20px 0; }

    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { display: none; }
    }
  </style>
</head>
<body>
  <div class="stars"></div>

  <div class="layout">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark"></div>
        <div class="brand-name">Painel</div>
      </div>

      <nav class="primary-nav">
        <div class="nav-label">Navegação</div>
        <a href="/" class="nav-item"><span class="nav-dot"></span>Início</a>
        <a href="/profile" class="nav-item active"><span class="nav-dot"></span>Usuários</a>
      </nav>

      <div class="sidebar-footer">
        <div class="status-line"><span class="pulse-dot"></span>Sistema operacional</div>
        Sessão autenticada
      </div>
    </aside>

    <main>
      <div class="topbar">
        <div>
          <div class="eyebrow">Área restrita</div>
          <h1>Todos os usuários</h1>
        </div>
      </div>

      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">Usuários cadastrados</div>
          <div class="panel-sub"><%= users.length %> registro<%= users.length !== 1 ? 's' : '' %></div>
        </div>

        <% if (users.length === 0) { %>
          <div class="empty-state">Nenhum usuário encontrado.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Usuário</th>
                <th>E-mail</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr>
                  <td>
                    <div class="row-user">
                      <div class="avatar"></div>
                      <%= user.name || '—' %>
                    </div>
                  </td>
                  <td><%= user.email || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
