<html lang='pt-br'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Painel</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <style>
      :root {
        --bg-deep: #0a0e1a;
        --panel: #121729;
        --panel-border: #232b45;
        --panel-raised: #161d33;
        --text-main: #e8ecf4;
        --text-muted: #7a85a3;
        --text-dim: #4a5170;
        --accent-a: #4fd1c5;
        --accent-b: #9f7aea;
        --danger: #f0708a;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg-deep);
        font-family: 'JetBrains Mono', monospace;
        color: var(--text-main);
        min-height: 100%;
      }

      body {
        position: relative;
        overflow-x: hidden;
      }

      .stars,
      .stars::after {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
          radial-gradient(1.5px 1.5px at 20px 30px, #ffffff40, transparent),
          radial-gradient(1.5px 1.5px at 140px 90px, #ffffff30, transparent),
          radial-gradient(1px 1px at 90px 160px, #ffffff28, transparent),
          radial-gradient(2px 2px at 220px 60px, #ffffff35, transparent),
          radial-gradient(1px 1px at 260px 200px, #ffffff22, transparent),
          radial-gradient(1.5px 1.5px at 320px 140px, #ffffff30, transparent),
          radial-gradient(1px 1px at 40px 220px, #ffffff22, transparent),
          radial-gradient(2px 2px at 380px 30px, #ffffff30, transparent);
        background-repeat: repeat;
        background-size: 400px 260px;
        z-index: 0;
        pointer-events: none;
      }

      .stars {
        animation: drift 220s linear infinite;
        opacity: 0.6;
      }

      @keyframes drift {
        from {
          transform: translateY(0);
        }
        to {
          transform: translateY(-1000px);
        }
      }

      .layout {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 240px 1fr;
        min-height: 100vh;
      }

      /* Sidebar */
      .sidebar {
        background: var(--panel);
        border-right: 1px solid var(--panel-border);
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .brand-mark {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
        flex-shrink: 0;
      }

      .brand-name {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: -0.01em;
      }

      nav.primary-nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .nav-label {
        font-size: 10.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 0 0 10px 10px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 8px;
        font-size: 13px;
        color: var(--text-muted);
        text-decoration: none;
        border: 1px solid transparent;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease;
      }

      .nav-item:hover {
        color: var(--text-main);
        background: var(--panel-raised);
      }

      .nav-item.active {
        color: var(--text-main);
        background: var(--panel-raised);
        border-color: var(--panel-border);
        position: relative;
      }

      .nav-item.active::before {
        content: '';
        position: absolute;
        left: -10px;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 16px;
        border-radius: 3px;
        background: linear-gradient(180deg, var(--accent-a), var(--accent-b));
      }

      .nav-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-dim);
        flex-shrink: 0;
      }
      .nav-item.active .nav-dot,
      .nav-item:hover .nav-dot {
        background: var(--accent-a);
      }

      .sidebar-footer {
        margin-top: auto;
        font-size: 11px;
        color: var(--text-dim);
        border-top: 1px solid var(--panel-border);
        padding-top: 16px;
        letter-spacing: 0.04em;
      }

      .status-line {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
      }

      .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-a);
        box-shadow: 0 0 0 0 rgba(79, 209, 197, 0.5);
        animation: pulse 2.2s ease-out infinite;
      }

      @keyframes pulse {
        0% {
          box-shadow: 0 0 0 0 rgba(79, 209, 197, 0.5);
        }
        70% {
          box-shadow: 0 0 0 8px rgba(79, 209, 197, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(79, 209, 197, 0);
        }
      }

      /* Main */
      main {
        padding: 32px 40px 60px;
        max-width: 1180px;
      }

      .topbar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .eyebrow {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 8px;
      }

      h1 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 30px;
        margin: 0;
        letter-spacing: -0.01em;
      }

      .clock {
        font-size: 12.5px;
        color: var(--text-muted);
        text-align: right;
        line-height: 1.6;
      }

      .clock strong {
        color: var(--text-main);
        font-weight: 500;
      }

      /* Stat cards */
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;
      }

      .card {
        position: relative;
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 14px;
        padding: 22px 22px 20px;
      }

      .card::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: 14px;
        padding: 1px;
        background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
        -webkit-mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0.18;
        animation: breathe 5s ease-in-out infinite;
        pointer-events: none;
      }

      @keyframes breathe {
        0%,
        100% {
          opacity: 0.1;
        }
        50% {
          opacity: 0.3;
        }
      }

      .stat-label {
        font-size: 10.5px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 12px;
      }

      .stat-value {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 30px;
        letter-spacing: -0.01em;
      }

      .stat-delta {
        margin-top: 8px;
        font-size: 12px;
        color: var(--text-muted);
      }

      .stat-delta.up {
        color: var(--accent-a);
      }
      .stat-delta.down {
        color: var(--danger);
      }

      /* Content grid */
      .content-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 18px;
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 14px;
        padding: 24px;
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
      }

      .panel-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 16px;
      }

      .panel-sub {
        font-size: 11px;
        color: var(--text-dim);
        letter-spacing: 0.06em;
      }

      /* Bar chart */
      .bars {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        height: 150px;
        margin-bottom: 10px;
      }

      .bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        height: 100%;
        justify-content: flex-end;
      }

      .bar {
        width: 100%;
        border-radius: 5px 5px 2px 2px;
        background: linear-gradient(180deg, var(--accent-a), var(--accent-b));
        opacity: 0.85;
      }

      .bar-day {
        font-size: 10px;
        color: var(--text-dim);
        letter-spacing: 0.06em;
      }

      /* Activity list */
      .activity-list {
        display: flex;
        flex-direction: column;
      }

      .activity-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid var(--panel-border);
        font-size: 12.5px;
      }

      .activity-row:last-child {
        border-bottom: none;
      }

      .activity-time {
        color: var(--text-dim);
        flex-shrink: 0;
        width: 52px;
      }
      .activity-text {
        color: var(--text-main);
        flex: 1;
      }
      .activity-tag {
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 20px;
        border: 1px solid var(--panel-border);
        color: var(--text-muted);
        flex-shrink: 0;
      }

      .activity-tag.ok {
        color: var(--accent-a);
        border-color: rgba(79, 209, 197, 0.3);
      }
      .activity-tag.warn {
        color: var(--accent-b);
        border-color: rgba(159, 122, 234, 0.3);
      }

      /* Table */
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
        margin-top: 4px;
      }
      th {
        text-align: left;
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-dim);
        font-weight: 500;
        padding: 0 0 10px;
        border-bottom: 1px solid var(--panel-border);
      }
      td {
        padding: 11px 0;
        border-bottom: 1px solid var(--panel-border);
        color: var(--text-main);
      }
      tr:last-child td {
        border-bottom: none;
      }
      .row-user {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .avatar {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: linear-gradient(135deg, var(--accent-a), var(--accent-b));
        opacity: 0.75;
      }
      .badge {
        font-size: 10.5px;
        letter-spacing: 0.04em;
        padding: 3px 9px;
        border-radius: 20px;
        border: 1px solid var(--panel-border);
        color: var(--text-muted);
      }
      .badge.ok {
        color: var(--accent-a);
        border-color: rgba(79, 209, 197, 0.3);
      }
      .badge.pending {
        color: var(--text-muted);
      }

      .full-width {
        grid-column: 1 / -1;
        margin-top: 18px;
      }

      @media (max-width: 980px) {
        .layout {
          grid-template-columns: 1fr;
        }
        .sidebar {
          display: none;
        }
        .stat-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .content-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class='stars'></div>

    <div class='layout'>
      <aside class='sidebar'>
        <div class='brand'>
          <div class='brand-mark'></div>
          <div class='brand-name'>Painel</div>
        </div>

        <nav class='primary-nav'>
          <div class='nav-label'>Navegação</div>
          <a href='#' class='nav-item active'><span class='nav-dot'></span>Visão geral</a>
          <a href='#' class='nav-item'><span class='nav-dot'></span>Projetos</a>
          <a href='#' class='nav-item'><span class='nav-dot'></span>Atividade</a>
          <a href='#' class='nav-item'><span class='nav-dot'></span>Equipe</a>
          <a href='#' class='nav-item'><span class='nav-dot'></span>Configurações</a>
        </nav>

        <div class='sidebar-footer'>
          <div class='status-line'><span class='pulse-dot'></span>Sistema operacional</div>
          Sessão autenticada
        </div>
      </aside>

      <main>
        <div class='topbar'>
          <div>
            <div class='eyebrow'>Área restrita</div>
            <h1>Bem-vindo de volta</h1>
          </div>
          <div class='clock'>
            Sexta-feira, 24 de julho de 2026<br />
            <strong>Última atualização: agora</strong>
          </div>
        </div>

        <section class='stat-grid'>
          <div class='card'>
            <div class='stat-label'>Sessões ativas</div>
            <div class='stat-value'>248</div>
            <div class='stat-delta up'>▲ 12% na semana</div>
          </div>
          <div class='card'>
            <div class='stat-label'>Disponibilidade</div>
            <div class='stat-value'>99.8%</div>
            <div class='stat-delta up'>▲ estável</div>
          </div>
          <div class='card'>
            <div class='stat-label'>Requisições hoje</div>
            <div class='stat-value'>6.4k</div>
            <div class='stat-delta up'>▲ 4% vs. ontem</div>
          </div>
          <div class='card'>
            <div class='stat-label'>Taxa de erro</div>
            <div class='stat-value'>0.6%</div>
            <div class='stat-delta down'>▼ 0.2% vs. ontem</div>
          </div>
        </section>

        <section class='content-grid'>
          <div class='panel'>
            <div class='panel-header'>
              <div class='panel-title'>Requisições da semana</div>
              <div class='panel-sub'>Últimos 7 dias</div>
            </div>
            <div class='bars'>
              <div class='bar-col'><div class='bar' style='height: 55%'></div><div class='bar-day'>SEG</div></div>
              <div class='bar-col'><div class='bar' style='height: 70%'></div><div class='bar-day'>TER</div></div>
              <div class='bar-col'><div class='bar' style='height: 46%'></div><div class='bar-day'>QUA</div></div>
              <div class='bar-col'><div class='bar' style='height: 85%'></div><div class='bar-day'>QUI</div></div>
              <div class='bar-col'><div class='bar' style='height: 62%'></div><div class='bar-day'>SEX</div></div>
              <div class='bar-col'><div class='bar' style='height: 38%'></div><div class='bar-day'>SÁB</div></div>
              <div class='bar-col'><div class='bar' style='height: 30%'></div><div class='bar-day'>DOM</div></div>
            </div>
          </div>

          <div class='panel'>
            <div class='panel-header'>
              <div class='panel-title'>Atividade recente</div>
              <div class='panel-sub'>Ao vivo</div>
            </div>
            <div class='activity-list'>
              <div class='activity-row'>
                <div class='activity-time'>09:41</div>
                <div class='activity-text'>Novo cadastro concluído</div>
                <div class='activity-tag ok'>OK</div>
              </div>
              <div class='activity-row'>
                <div class='activity-time'>09:22</div>
                <div class='activity-text'>Login realizado</div>
                <div class='activity-tag ok'>OK</div>
              </div>
              <div class='activity-row'>
                <div class='activity-time'>08:57</div>
                <div class='activity-text'>Tentativa de senha inválida</div>
                <div class='activity-tag warn'>ALERTA</div>
              </div>
              <div class='activity-row'>
                <div class='activity-time'>08:10</div>
                <div class='activity-text'>Backup diário concluído</div>
                <div class='activity-tag ok'>OK</div>
              </div>
            </div>
          </div>

          <div class='panel full-width'>
            <div class='panel-header'>
              <div class='panel-title'>Usuários recentes</div>
              <div class='panel-sub'>4 registros</div>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Usuário</th>
                  <th>E-mail</th>
                  <th>Status</th>
                  <th>Entrou em</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><div class='row-user'><div class='avatar'></div>Ana Souza</div></td>
                  <td>ana.souza@example.com</td>
                  <td><span class='badge ok'>Ativo</span></td>
                  <td>hoje, 09:41</td>
                </tr>
                <tr>
                  <td><div class='row-user'><div class='avatar'></div>Marcos Lima</div></td>
                  <td>marcos.lima@example.com</td>
                  <td><span class='badge ok'>Ativo</span></td>
                  <td>hoje, 09:22</td>
                </tr>
                <tr>
                  <td><div class='row-user'><div class='avatar'></div>Beatriz Rocha</div></td>
                  <td>beatriz.rocha@example.com</td>
                  <td><span class='badge pending'>Pendente</span></td>
                  <td>ontem, 18:04</td>
                </tr>
                <tr>
                  <td><div class='row-user'><div class='avatar'></div>João Vitor</div></td>
                  <td>joao.vitor@example.com</td>
                  <td><span class='badge ok'>Ativo</span></td>
                  <td>ontem, 14:30</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
