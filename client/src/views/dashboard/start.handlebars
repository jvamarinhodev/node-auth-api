<html lang='pt-br'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Usuários públicos</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <link rel='stylesheet' href='/css/start.css' />

  </head>
  <body>
    <div class='stars'></div>

    <div class='layout'>
      <aside class='sidebar'>
        <div class='brand'>
          <div class='brand-mark'></div>
          <div class='brand-name'>Painel</div>
        </div>

        <nav class='primary-nav'>
          <div class='nav-label'>Navegação</div>
          <a href='/private/profile' class='nav-item'><span class='nav-dot'></span>Usários Privados</a>
          <a href='/home/profile' class='nav-item active'><span class='nav-dot'></span>Usuários Públicos</a>
        </nav>

        <div class='sidebar-footer'>
          <div class='status-line'><span class='pulse-dot'></span>Sistema operacional</div>
          Acesso público
        </div>
      </aside>

      <main>
        <div class='topbar'>
          <div>
            <div class='eyebrow'>Acesso público</div>
            <h1>Usuários públicos</h1>
          </div>
          <div class='search-box'>
            <span>🔍</span>
            <input type='text' placeholder='Buscar usuário...' />
          </div>
        </div>

        <section class='panel'>
          <div class='panel-header'>
            <div class='panel-title'>Perfis públicos</div>
            <div class='panel-sub'>{{users.length}} registro{{#unless (eq users.length 1)}}s{{/unless}}</div>
          </div>

          {{#if users.length}}
            <div class='cards-grid'>
              {{#each users}}
                <div class='user-card'>
                  <div class='avatar'>{{initial this.name}}</div>
                  <div class='user-info'>
                    <div class='user-name'>{{#if this.name}}{{this.name}}{{else}}Usuário{{/if}}</div>
                    <div class='user-handle'>@{{#if this.username}}{{this.username}}{{else}}{{slug
                          this.name
                        }}{{/if}}</div>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class='empty-state'>Nenhum usuário encontrado.</div>
          {{/if}}
        </section>
      </main>
    </div>
  </body>
</html>
