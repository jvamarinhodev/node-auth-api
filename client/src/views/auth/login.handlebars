<html lang='pt-br'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Home</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=JetBrains+Mono:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <link rel='stylesheet' href='/css/initial.css' />
  </head>
  <body>
    <div class='stars'></div>

    <div class='layout'>

      {{#if error}}
        <ul class='error'>
          {{#each error}}
            <li>{{this.field}}: {{this.massage}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if globalError}}
        <div class='error-global'>{{globalError}}</div>
      {{/if}}

      <form action='/login' method='post' class='card' autocomplete='off'>
        <div class='eyebrow'>Restricted access</div>
        <h1>Welcome back</h1>

        <div class='field'>
          <label for='email'>E-mail</label>
          <input
            type='email'
            id='email'
            name='email'
            placeholder='your-email@example.com'
            ,
            value={{values.email}}
            required
          />
        </div>

        <div class='field'>
          <label for='password'>Password</label>
          <input type='password' id='password' name='password' placeholder='••••••••' required />
        </div>

        <div class='row-between'>
          <span class='remember'>
            <input type='checkbox' id='remember' />
            <label for='remember' style='margin: 0; text-transform: none; font-size: 12.5px; letter-spacing: 0'>Remember
              me</label>
          </span>
          <a href='#' class='link'>Forgot your password?</a>
        </div>

        <button type='submit'>Enter</button>

        <div class='footer-note'>Ha not account? <a href='/register' class='link'>Create now</a></div>
      </form>
    </div>
  </body>
</html>
