<html lang='pt-br'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Home</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=JetBrains+Mono:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <link rel='stylesheet' href='/css/initial.css' />
  </head>
  <body>
    <div class='stars'></div>

    <div class='layout'>

      {{#if error}}
        <ul class='error'>
          {{#each error}}
            <li>{{this.field}}: {{this.message}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if globalError}}
        <div class='error-global'>{{globalError}}</div>
      {{/if}}

      <form action='/register' method='post' class='card' autocomplete='off'>
        <div class='eyebrow'>Restricted access</div>
        <h1>Welcome</h1>

        <div class='field'>
          <label for='name'>Name</label>
          <input type='text' id='name' name='name' placeholder='your name' value='{{values.name}}' required />
        </div>

        <div class='field'>
          <label for='email'>E-mail</label>
          <input
            type='email'
            id='email'
            name='email'
            placeholder='your-email@example.com'
            value='{{values.email}}'
            required
          />
        </div>

        <div class='field'>
          <label for='password'>Password</label>
          <input type='password' id='password' name='password' placeholder='••••••••' required />
        </div>

        <button type='submit'>Register</button>

        <div class='footer-note'>Do you have an account? <a href='/login' class='link'>Login</a></div>
      </form>
    </div>
  </body>
</html>
